---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Brands from '../components/Brands.astro';
import Vitrificacao from '../components/Vitrificacao.astro';
import Servicos from '../components/Servicos.astro';
import Insulfilm from '../components/Insulfilm.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import Contato from '../components/Contato.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Header />
  <main id="conteudo" tabindex="-1">
    <Hero />
    <Brands />
    <Vitrificacao />
    <Servicos />
    <Insulfilm />
    <ComoFunciona />
    <Contato />
    <CtaFinal />
  </main>
  <Footer />
</Base>
